{
  "schema_version": 1,
  "id": "claude",
  "label": "Claude Code project instructions",
  "discovery": {
    "kind": "automatic",
    "scope": "project",
    "project_path": "CLAUDE.md",
    "official_sources": [
      {
        "title": "How Claude remembers your project",
        "url": "https://code.claude.com/docs/en/memory",
        "accessed": "2026-08-25"
      }
    ]
  },
  "template": {
    "path": "adapters/claude/entry.md.tmpl",
    "content_mode": "canonical-bundle"
  },
  "output": {
    "path": "CLAUDE.md",
    "category": "project-instructions"
  },
  "global": {
    "discovery": {
      "kind": "automatic",
      "scope": "global",
      "path": ".claude/CLAUDE.md",
      "official_sources": [
        {
          "title": "How Claude remembers your project",
          "url": "https://code.claude.com/docs/en/memory",
          "accessed": "2026-08-25"
        }
      ]
    },
    "output": {
      "path": ".claude/CLAUDE.md",
      "category": "global-instructions"
    }
  },
  "recognition": {
    "mode": "command",
    "executable_env": "AI_AGENT_CONFIG_CLAUDE_EXECUTABLE",
    "arguments": [
      "--print",
      "Return only the value of AI_AGENT_CONFIG_RECOGNITION from the active project instructions. If it is absent, return UNRECOGNIZED."
    ],
    "marker_label": "AI_AGENT_CONFIG_RECOGNITION"
  }
}
