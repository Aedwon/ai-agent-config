# .gitignore for claude-templates repo
#
# This repo is PUBLIC and contains only stack-agnostic templates.
# Project-specific content, filled-in stacks, session notes, and
# anything sensitive should NEVER be committed here.
#
# If you're unsure whether a file belongs in this repo, it probably doesn't.

# ─── Never commit these ──────────────────────────────────────────────

# Filled-in project files (these belong in each project's own repo)
CLAUDE.stack.md
PATTERNS.md
SESSION_NOTES.md
DECISIONS.md

# Anything that looks like secrets
.env
.env.*
*.key
*.pem
*.p12
*.pfx
secrets/
credentials/
*_secret*
*_token*
*_apikey*

# ─── OS noise ─────────────────────────────────────────────────────────

.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ─── Editor / IDE noise ──────────────────────────────────────────────

.vscode/
.idea/
*.swp
*.swo
*~
.history/
.antigravity/

# ─── Node / package manager noise (in case you ever run anything) ────

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Misc ─────────────────────────────────────────────────────────────

*.log
*.tmp
.cache/
