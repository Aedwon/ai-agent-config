{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "github-readiness-sentinel",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "github-readiness-sentinel",
      "database_id": "REPLACE_AFTER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "github-readiness-events"
      }
    ],
    "consumers": [
      {
        "queue": "github-readiness-events",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
